# ============================================
# EasyFood — variáveis de ambiente
# Copie para .env:  copy .env.example .env   (Windows)
#                   cp .env.example .env     (macOS/Linux)
# O arquivo .env NUNCA deve ser enviado ao GitHub.
# ============================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Banco de dados (Neon / PostgreSQL) ---
# Atenção: comentários precisam começar com #, e a URL fica entre aspas.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# --- CORS ---
# Lista separada por vírgula. Vazio libera tudo (só em desenvolvimento).
CORS_ORIGINS=

# ============================================
# AUTENTICAÇÃO
#   local   -> JWT + bcrypt (desenvolvimento, sem AWS)
#   cognito -> AWS Cognito (produção)
# ============================================
AUTH_PROVIDER=local

# --- Usado quando AUTH_PROVIDER=local ---
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=1d

# --- Usado quando AUTH_PROVIDER=cognito ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Preencha apenas se o App Client tiver sido criado COM secret.
COGNITO_CLIENT_SECRET=

# ============================================
# E-MAIL (Atividade 6)
# Sem EMAIL_API_KEY a API sobe normalmente e os e-mails só aparecem no log
# (EMAIL_PROVIDER=console). Para enviar de verdade: crie uma chave em
# resend.com e preencha abaixo.
# ============================================
# resend -> envia de verdade | console -> só registra no log
EMAIL_PROVIDER=console
EMAIL_API_KEY=
# Sem domínio verificado, o Resend só aceita este remetente de teste:
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=EasyFood
# Sem domínio verificado, o Resend só entrega para o e-mail da SUA conta.
EMAIL_TO_TEST=
EMAIL_TO_COMMERCIAL=
# Liga uma falha artificial para provar que o cadastro sobrevive (teste).
EMAIL_SIMULATE_FAILURE=false

# ============================================
# SERVERLESS (simulador local — opcional)
# ============================================
# Atraso simulado de cold start e janela em que o ambiente fica "quente".
FAAS_COLD_START_MS=900
FAAS_WARM_WINDOW_MS=300000
