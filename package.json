{
  "name": "easy-food",
  "version": "2.1.0",
  "description": "EasyFood API — monólito modular em camadas, com autenticação plugável, serviço de e-mail compartilhado e função serverless de imagens",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "smoke": "node scripts/smoke-test.js",
    "image:local": "node scripts/optimize-image-local.js",
    "image:test": "node scripts/image-test.js",
    "test": "npm run smoke && npm run image:test",
    "front:test": "node scripts/front-test.js"
  },
  "keywords": [
    "express",
    "prisma",
    "postgresql",
    "cognito",
    "arquitetura-em-camadas"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.637.0",
    "@prisma/client": "^5.22.0",
    "aws-jwt-verify": "^4.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=18"
  }
}
